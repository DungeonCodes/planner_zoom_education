      plus:LicensorURL="https://www.shutterstock.com/image-photo/758103907?utm_source=iptc&amp;utm_medium=googleimages&amp;utm_campaign=image"/>
    </rdf:Seq>
   </plus:Licensor>
  </rdf:Description>
 </rdf:RDF>
