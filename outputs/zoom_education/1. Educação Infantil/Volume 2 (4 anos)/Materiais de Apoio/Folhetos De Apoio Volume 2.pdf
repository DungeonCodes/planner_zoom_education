   xmpRights:WebStatement="https://www.shutterstock.com/license?utm_source=iptc&amp;utm_medium=googleimages&amp;utm_campaign=webstatement"
   xmp:CreateDate="2017-11-19">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Kirill Dorofeev</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A large group kittens of lion (cub of lion)  and lioness (female of lion) are moving on savanna's road. It is a good illustration on soft light which shows wild life and natural habitat.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">758103907</rdf:li>
    </rdf:Alt>
   </dc:title>
